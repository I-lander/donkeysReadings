# Server (LLM API)
OPENAI_API_KEY=
PORT=3001

# Quota / rewarded ads
FREE_READINGS_PER_DAY=3
CREDITS_PER_AD=1
DB_PATH=donkeys.db
# Set to true ONLY for local testing without real AdMob SSV signatures
ADMOB_SSV_SKIP_VERIFY=false

# Client: base URL of the reading API.
# Empty in dev (Vite proxies /api to localhost:3001).
# For the Android build, set the deployed server URL, e.g. https://api.example.com
VITE_API_URL=

# Client: AdMob rewarded ad unit id. Leave empty to use Google's test ad unit.
VITE_ADMOB_REWARDED_AD_ID=

# Google Sign-In (optional; leave both empty to disable the feature).
# Both take the SAME value: the OAuth "Web application" client ID from the
# Google Cloud console (an Android client ID must also exist in the same
# project for native sign-in, but is not referenced here).
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
